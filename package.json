{
  "name": "agent-project-foundation-kit",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "publish:changes": "node kit/scripts/publish-changes.mjs",
    "publish:pr-only": "node kit/scripts/publish-changes.mjs --mode pr-only",
    "publish:merge-pr": "node kit/scripts/publish-changes.mjs --mode merge-pr",
    "publish:merge-pr:auto": "node kit/scripts/publish-changes.mjs --mode merge-pr --auto-merge",
    "install:node": "node scripts/install-foundation-kit.mjs",
    "test:install": "pnpm test:install:node",
    "test:install:node": "vitest run tests/install-foundation-kit",
    "test": "vitest run",
    "test:node": "vitest run",
    "test:publish": "pnpm test:publish:node",
    "test:publish:node": "vitest run tests/publish-changes",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:fix": "biome check --write .",
    "check": "biome check . && pnpm test:publish && pnpm test:install && git diff --check"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "vitest": "^4.1.8"
  }
}
